# =====================================================================
# SecureMailScope X - Environment Configuration Template
# Phase 28: PostgreSQL / Supabase Migration & Deployment Readiness
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# For Local Development (leave blank to use backend/data/securemailscope.db):
# DATABASE_URL=

# For Production / Supabase PostgreSQL Deployment:
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------
# CORS Origins (comma-separated list of allowed frontend origins)
# ---------------------------------------------------------------------
# Local dev + Vercel deployment URL
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,https://securemailscope-x.vercel.app

# ---------------------------------------------------------------------
# Application Environment & Security
# ---------------------------------------------------------------------
APP_ENV=production
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# ---------------------------------------------------------------------
# Report & File Storage Mode (local_ephemeral | supabase_storage)
# ---------------------------------------------------------------------
REPORT_STORAGE_MODE=local_ephemeral
